{
  "appId": "com.aurora.player",
  "appName": "Aurora Player",
  "webDir": "dist",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#070913"
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK"
    }
  }
}